LLM_ENABLED=true
LLM_PROVIDER=openai
OPENAI_BASE_URL=https://api.proxyapi.ru/v1
OPENAI_API_KEY=
LLM_MODEL=gpt-6-luna
AGENT_MAX_ITERATIONS=5
AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_WEB_SEARCHES=2
AGENT_TIMEOUT_SECONDS=10
AGENT_MAX_OUTPUT_TOKENS=2400
AGENT_MAX_CONCURRENT_RUNS=4
AGENT_RESULT_CACHE_TTL_SECONDS=120

# Docker Compose
# SMART_SEARCH_SNAPSHOT_DIR=./deployment-data/snapshot
# SMART_SEARCH_STATE_DIR=./deployment-data/state
# HF_HUB_OFFLINE=0
